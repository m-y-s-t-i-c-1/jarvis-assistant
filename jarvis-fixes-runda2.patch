+  const butoane = document.createElement('div');
+  butoane.style.cssText = 'display:flex;gap:8px;justify-content:flex-end;';
+  const raspunde = (aprobat) => {
+    if (ws && ws.readyState === 1) ws.send(JSON.stringify({ tip: 'confirmare', id: d.id, aprobat: aprobat }));
+    overlay.remove();
+  };
+  const nu = document.createElement('button');
+  nu.textContent = 'Refuză';
+  nu.style.cssText = 'padding:6px 14px;border-radius:6px;border:1px solid #4a5568;background:transparent;color:inherit;cursor:pointer;';
+  nu.onclick = () => raspunde(false);
+  const da = document.createElement('button');
+  da.textContent = 'Aprobă';
+  da.style.cssText = 'padding:6px 14px;border-radius:6px;border:0;background:#2b6cb0;color:#fff;cursor:pointer;';
+  da.onclick = () => raspunde(true);
+  butoane.append(nu, da);
+  card.append(titlu, corp, butoane);
+  overlay.append(card);
+  document.body.appendChild(overlay);
+  setTimeout(() => { if (overlay.isConnected) raspunde(false); }, ((d.timeout || 60) * 1000));
