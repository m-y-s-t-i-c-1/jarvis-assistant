# Copiază acest fișier ca .env (necomis în git) și completează cheile.
# Doar GEMINI_API_KEY e obligatorie; restul sunt opționale (fallback-uri și funcții extra).
# Pentru nume/oraș/fus orar vezi și config/jarvis.example.toml (variabilele de aici au prioritate).

# ── Gemini (obligatoriu: unelte, vedere, memorie) ─────────────────────────────
GEMINI_API_KEY=
# Chei suplimentare pentru rotație când una atinge limita (opțional, până la _5)
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# GEMINI_MODEL=gemini-3.6-flash

# ── Fallback-uri text (opțional) ──────────────────────────────────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
BYTEZ_API_KEY=
# BYTEZ_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ── NVIDIA NIM (opțional: conversație, cod, vedere) ───────────────────────────
NVIDIA_API_KEY_CONVERSATION_1=
NVIDIA_API_KEY_CONVERSATION_2=
NVIDIA_API_KEY_CONVERSATION_3=
NVIDIA_API_KEY_CONVERSATION_4=
NVIDIA_API_KEY_CODING=
NVIDIA_API_KEY_CODING_2=
NVIDIA_API_KEY_CODING_3=
NVIDIA_API_KEY_MULTIMODAL=
NVIDIA_API_KEY_MULTIMODAL_2=
NVIDIA_API_KEY_MULTIMODAL_3=
# NVIDIA_MODEL_CONVERSATIE=nvidia/llama-3.3-nemotron-super-49b-v1.5
# NVIDIA_MODEL_CODING=deepseek-ai/deepseek-v4-pro-0813
# NVIDIA_MODEL_MULTIMODAL=minimaxai/minimax-m3

# ── Persoană și locație (alternativ: config/jarvis.toml) ──────────────────────
# JARVIS_USER=Vasea
# JARVIS_ORAS=Chișinău
# JARVIS_TIMEZONE=Europe/Chisinau
# JARVIS_CONFIG=/cale/către/alt/jarvis.toml

# ── Voce ──────────────────────────────────────────────────────────────────────
# PIPER_BINARY=piper
# PIPER_MODEL=voci_piper/ro_RO-mihai-medium.onnx
# TTS_SINK=echo-cancel-sink
# WAKE_WORD_MODEL=/cale/către/hey_jarvis_v0.1.onnx
# ALLOW_SOUNDDEVICE_TTS=1
# JARVIS_VOICE_IDLE_SECONDS=30

# ── Monitorizare ecran ────────────────────────────────────────────────────────
# Oprit implicit. 1 = pornit: trimite periodic screenshot-uri către API-uri externe.
# JARVIS_MONITOR_ECRAN=0

# ── Interfața web ─────────────────────────────────────────────────────────────
# JARVIS_HOST=127.0.0.1
# JARVIS_PORT=8080
# JARVIS_ALLOWED_ORIGINS=
